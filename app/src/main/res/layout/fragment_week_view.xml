<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="10dp"
    android:background="@android:color/white"
    tools:context=".ui.calendar.week_view.WeekViewFragment">


        <!-- Month/Year title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp"
            android:layout_marginTop="20dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/week_navigation_previous"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:icon="@drawable/baseline_arrow_back_24"
                app:iconGravity="start"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:background="@null"
                android:textSize="20sp"/>

            <TextView
                android:id="@+id/monthYearTV"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Listopad 2025"
                android:layout_weight="3"
                android:textColor="@color/black"
                android:textSize="25sp"
                android:textStyle="bold"
                android:gravity="center"
                />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/week_navigation_next"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:icon="@drawable/baseline_arrow_forward_24"
                app:iconGravity="end"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:background="@null"
                android:textSize="20sp" />

        </LinearLayout>

        <!-- Weekday names -->
        <LinearLayout
            android:id="@+id/weekDaysRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView android:text="Mon" android:layout_weight="1" android:gravity="center" android:layout_height="wrap_content" android:layout_width="0dp"/>
            <TextView android:text="Tue" android:layout_weight="1" android:gravity="center" android:layout_height="wrap_content" android:layout_width="0dp"/>
            <TextView android:text="Wed" android:layout_weight="1" android:gravity="center" android:layout_height="wrap_content" android:layout_width="0dp"/>
            <TextView android:text="Thu" android:layout_weight="1" android:gravity="center" android:layout_height="wrap_content" android:layout_width="0dp"/>
            <TextView android:text="Fri" android:layout_weight="1" android:gravity="center" android:layout_height="wrap_content" android:layout_width="0dp"/>
            <TextView android:text="Sat" android:layout_weight="1" android:gravity="center" android:layout_height="wrap_content" android:layout_width="0dp"/>
            <TextView android:text="Sun" android:layout_weight="1" android:gravity="center" android:layout_height="wrap_content" android:layout_width="0dp"/>

        </LinearLayout>

        <!-- Calendar RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/calendarRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>

    <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="right"
        android:text="Dodaj wydarzenie"
        android:onClick="newEventAction"
        android:textColor="@color/white"
        android:background="@null"
        android:textStyle="bold"
        android:id="@+id/newEventButton"
        android:textSize="20sp"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/eventRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="5"/>

    
    </LinearLayout>

