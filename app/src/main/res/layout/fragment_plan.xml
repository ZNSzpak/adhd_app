<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">



    <TableLayout
        android:id="@+id/timetableTable"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:stretchColumns="1,2,3,4,5,6"
        android:padding="8dp">

        <!-- Header Row -->
        <TableRow android:padding="4dp">

            <TextView
                android:text="Time"
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView android:text="Mon" android:gravity="center"/>
            <TextView android:text="Tue" android:gravity="center"/>
            <TextView android:text="Wed" android:gravity="center"/>
            <TextView android:text="Thu" android:gravity="center"/>
            <TextView android:text="Fri" android:gravity="center"/>
        </TableRow>
    </TableLayout>

        <FrameLayout
            android:id="@+id/blockContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"/>
        </FrameLayout>
    </ScrollView>

<com.google.android.material.floatingactionbutton.FloatingActionButton
android:id="@+id/addBlockButton"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:layout_alignParentBottom="true"
android:layout_alignParentEnd="true"
android:layout_margin="40dp"
android:src="@drawable/baseline_add_24"
android:backgroundTint="#DD9AEB"/>
</RelativeLayout>